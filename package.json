{
  "name": "@yarkivaev/scada",
  "version": "2.5.0",
  "description": "SCADA domain objects, state persistence, and plant monitoring",
  "repository": {
    "type": "git",
    "url": "https://github.com/yarkivaev/scada"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./src/infrastructure/client/index.js",
    "./stateDataFake": "./src/infrastructure/persistence/stateDataFromMemory.js",
    "./startTestEdgeApi": "./src/infrastructure/http/edge/startTestEdgeApi.js",
    "./package.json": "./package.json",
    "./rabbitmq/definitions": "./src/infrastructure/messaging/rabbitmq/definitions.js",
    "./rabbitmq/reconcile": "./src/infrastructure/messaging/rabbitmq/reconcile.js",
    "./opcua": "./src/infrastructure/opcua/index.js",
    "./opcua/config": "./src/infrastructure/opcua/config.js",
    "./runtime": "./src/application/runtime/index.js",
    "./streams": "./src/infrastructure/streams/index.js",
    "./control": "./src/application/control/index.js"
  },
  "bin": {
    "modbus-to-mqtt": "./src/bin/modbus-to-mqtt.js",
    "supervisor-sink": "./src/bin/supervisor-sink.js",
    "scada-collector": "./src/bin/collector.js",
    "scada-controller": "./src/bin/controller.js"
  },
  "scripts": {
    "test": "mocha --exit 'test/**/test*.js'",
    "test:deep": "mocha --exit 'test/domain/**/test*.js' 'test/infrastructure/ingest/**/test*.js'",
    "coverage": "c8 --all --src src npm test",
    "lint": "eslint . && node scripts/check-eo-names.mjs",
    "lint:fix": "eslint . --fix",
    "lint:eo": "node scripts/check-eo-names.mjs"
  },
  "dependencies": {
    "@clickhouse/client": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.24.3",
    "@yarkivaev/simple-server": "1.0.2",
    "@yarkivaev/source-to-sink": "2.0.0",
    "amqplib": "^0.10.9",
    "better-sqlite3": "^11.0.0",
    "modbus-serial": "^8.0.0",
    "mqtt": "^5.0.0",
    "node-opcua": "2.179.0",
    "pg": "^8.0.0",
    "serialport": "^12.0.0",
    "stompit": "^1.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "c8": "^10.1.3",
    "cassandra-driver": "^4.7.2",
    "eslint": "^9.39.2",
    "globals": "^17.0.0",
    "mocha": "^10.8.2",
    "testcontainers": "^10.13.0"
  },
  "files": [
    "index.js",
    "charts/",
    "db/",
    "src/"
  ]
}
