{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "processes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "command"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                {
                  "type": "object",
                  "required": [
                    "valueFrom"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "valueFrom": {
                      "type": "object",
                      "minProperties": 1
                    }
                  }
                }
              ]
            }
          },
          "health": {
            "type": "object",
            "required": [
              "port"
            ],
            "additionalProperties": false,
            "properties": {
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "livenessPath": {
                "type": "string",
                "pattern": "^/"
              },
              "readinessPath": {
                "type": "string",
                "pattern": "^/"
              },
              "initialDelaySeconds": {
                "type": "integer",
                "minimum": 0
              },
              "periodSeconds": {
                "type": "integer",
                "minimum": 1
              },
              "timeoutSeconds": {
                "type": "integer",
                "minimum": 1
              },
              "failureThreshold": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "hostDevices": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^/dev/([a-zA-Z0-9_-][a-zA-Z0-9_.-]*/)*[a-zA-Z0-9_-][a-zA-Z0-9_.-]*$"
            }
          }
        }
      }
    },
    "extraObjects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "apiVersion",
          "kind",
          "metadata"
        ]
      }
    },
    "postgres": {
      "type": "object",
      "properties": {
        "podTemplate": {
          "type": "object",
          "description": "Opaque PodTemplateSpec override for preserving existing storage pods during adoption; empty uses generated defaults."
        },
        "migrationsMode": {
          "type": "string",
          "enum": [
            "apply",
            "verify"
          ]
        },
        "runtimeSecret": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "enabled",
              "migrationsMode"
            ],
            "properties": {
              "enabled": {
                "const": true
              },
              "migrationsMode": {
                "const": "verify"
              }
            }
          },
          "then": {
            "required": [
              "runtimeSecret"
            ],
            "properties": {
              "runtimeSecret": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "rabbitmq": {
      "type": "object",
      "properties": {
        "podTemplate": {
          "type": "object",
          "description": "Opaque PodTemplateSpec override for preserving existing storage pods during adoption; empty uses generated defaults."
        },
        "definitionsSecret": {
          "type": "string"
        },
        "runtimeSecret": {
          "type": "string"
        }
      }
    }
  }
}
